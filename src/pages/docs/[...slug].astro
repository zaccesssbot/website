---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { GROUPS, PAGES, SOURCES, hrefFor } from "../../data/docs-nav";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  const pages = entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
  // each product in the Use section has a landing page listing its pages
  const groups = GROUPS.map((group) => ({ params: { slug: group.id }, props: { group } }));
  return [...pages, ...groups];
}

const { entry, group } = Astro.props;
const entries = await getCollection("docs");
const bySlug = new Map(entries.map((e) => [e.id, e]));

let page = null;
if (entry) {
  const { Content, headings } = await render(entry);
  page = { Content, headings, data: entry.data, href: hrefFor(entry.id) };
}

// the landing page: the group's pages in manifest order, with the install page and the release
const listed = group
  ? PAGES.filter((p) => p.section === "use" && p.group === group.id).map((p) => bySlug.get(p.slug)).filter((e) => e !== undefined)
  : [];
const install = group ? bySlug.get(`install/${group.id}`) : undefined;
const source = group ? SOURCES[group.id] : undefined;
const groupRef = listed[0]?.data ?? install?.data;
---
{page && (
  <DocsLayout
    title={page.data.title}
    description={page.data.description}
    href={page.href}
    headings={page.headings}
    origin={{ product: page.data.product, refLabel: page.data.refLabel, release: page.data.release, sourceUrl: page.data.sourceUrl, path: page.data.path }}
  >
    <page.Content />
  </DocsLayout>
)}
{group && source && (
  <DocsLayout title={`${source.name} documentation`} description={group.summary} href={hrefFor(group.id)}>
    <p>{group.summary}</p>
    {groupRef && (
      <p>
        These pages describe {source.name} {groupRef.release ? `v${groupRef.release}` : groupRef.refLabel}, read from <a href={`https://github.com/${source.repo}`}>{source.repo}</a> on GitHub.
        {install && <Fragment> Start with <a href={hrefFor(install.id)}>{install.data.title}</a>.</Fragment>}
      </p>
    )}
    <ul class="docs-list">
      {listed.map((e) => (
        <li>
          <a href={hrefFor(e.id)}>{e.data.title}</a>
          <p>{e.data.description}</p>
        </li>
      ))}
    </ul>
  </DocsLayout>
)}
